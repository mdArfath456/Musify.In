# Only needed locally if you're not using the Vercel same-origin rewrite —
# see src/config.js.
# VITE_API_URL=http://localhost:3000/api

# Clerk — used only for the signup email-verification step (see Register.jsx
# / VerifyOtp.jsx). Publishable key (safe to expose client-side), from
# Clerk Dashboard → API Keys. Must match the same Clerk project as the
# backend's CLERK_SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

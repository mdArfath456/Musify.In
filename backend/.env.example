# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key ONLY — this backend is the sole caller of Postgres/Storage,
# never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for uploaded audio files — create it in Storage, make it Public
SUPABASE_STORAGE_BUCKET=music-files

# Any long random string — used to sign JWTs
JWT_SECRET=your-jwt-secret

# Exact origin of your deployed frontend, no trailing slash
# e.g. https://musify-frontend.vercel.app
FRONTEND_URL=

# Set to "production" on your host (Render/Railway) so cookies get
# secure + sameSite=none, which is required for a cross-domain frontend.
NODE_ENV=development

# Most hosts (Render, Railway) inject PORT automatically — leave unset locally.
PORT=3000


JWT_ISSUER=musify-api
JWT_AUDIENCE=musify-app

# --- Clerk (signup email verification only — login/password/session stay yours) ---
# Dashboard → API Keys. Use the SECRET key here, never the publishable one.
CLERK_SECRET_KEY=your-clerk-secret-key
# Also required in the frontend's .env as VITE_CLERK_PUBLISHABLE_KEY
# (the publishable key, safe to expose client-side).
#
# One-time setup in the Clerk Dashboard before this works:
#   User & Authentication → Email, Phone, Username →
#     - Email address: ON, verification method "Email verification code"
#     - Password: set to OFF (or "not required") — signup here only
#       collects an email to verify, your own password stays in Postgres

# --- Email (forgot-password / OTP verification) ---
# Brevo is preferred when set (used first, ahead of Resend below).
# Sign up free at https://brevo.com, grab an API key under
# SMTP & API → API Keys, and verify a sender address under Senders.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Musify

# Resend — fallback if Brevo isn't configured. Leave both unset for local
# dev and the email service just logs the OTP to the console instead.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Musify <onboarding@resend.dev>

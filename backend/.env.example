# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key ONLY — this backend is the sole caller of Postgres/Storage,
# never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for uploaded audio files — create it in Storage, make it Public
SUPABASE_STORAGE_BUCKET=music-files

# Any long random string — used to sign JWTs
JWT_SECRET=your-jwt-secret

# Exact origin of your deployed frontend, no trailing slash
# e.g. https://musify-frontend.vercel.app
FRONTEND_URL=

# Set to "production" on your host (Render/Railway) so cookies get
# secure + sameSite=none, which is required for a cross-domain frontend.
NODE_ENV=development

# Most hosts (Render, Railway) inject PORT automatically — leave unset locally.
PORT=3000


JWT_ISSUER=musify-api
JWT_AUDIENCE=musify-app

# --- Email (registration / first-login OTP and password reset link) ---
# Delivered via EmailJS (https://emailjs.com). Dashboard → Email Services
# for the service ID, Account → API Keys for the public/private key pair.
# EMAILJS_PRIVATE_KEY must NEVER be exposed to the frontend — it is what
# authorizes this backend to call EmailJS's REST API directly ("strict
# mode"), bypassing EmailJS's normal browser-origin allow-list.
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key

# OTP templates use {{username}}, {{otp}}, {{expiry_minutes}}, {{to_email}},
# {{subject}}, {{heading}} and {{intro}} variables.
EMAILJS_VERIFY_TEMPLATE_ID=your-verify-email-template-id
EMAILJS_FIRST_LOGIN_TEMPLATE_ID=your-first-login-template-id

# Password reset link template uses {{username}}, {{reset_url}},
# {{expiry_minutes}}, {{to_email}}, {{subject}}, {{heading}} and {{intro}}.
EMAILJS_RESET_LINK_TEMPLATE_ID=your-password-reset-link-template-id

# How long an OTP stays valid. Leave both this and the EmailJS variables
# unset for local dev and the email service just logs the OTP to the
# console instead (development only — never falls back like this in
# production; see backend/src/services/email.service.js).
OTP_EXPIRY_MINUTES=10
